{
  "name": "CalculatedField",
  "type": "object",
  "description": "Derivation rules run by the runCalculatedFields engine: on ingest, on change, and before every outbound webhook payload is built. Schema matches the canonical Legenex calculated-fields export format so rule sets move between properties unchanged.",
  "properties": {
    "output_token": {
      "type": "string",
      "description": "Unique output key. Written to Lead.calculated_fields[output_token]."
    },
    "output_label": {
      "type": "string"
    },
    "vertical": {
      "type": "string"
    },
    "input_field": {
      "type": "string",
      "description": "A Lead canonical field, a Lead.custom_fields key, or another rule's output_token. Empty for conditional rules that read fields from their own conditions."
    },
    "depends_on": {
      "type": "array",
      "description": "Other output_tokens this rule consumes. Used for dependency ordering and cycle detection."
    },
    "transform_type": {
      "type": "string",
      "enum": [
        "value_map",
        "date_age_bucket",
        "clone",
        "conditional",
        "script"
      ],
      "default": "value_map"
    },
    "config": {
      "type": "string",
      "description": "Transform-specific configuration, stored as a JSON string (matching the export format).\n- value_map: {\"map\":{from:to},\"default\":\"...\"}\n- date_age_bucket: {\"buckets\":[{\"label\":\"...\",\"max_days\":N}],\"fallback\":\"...\",\"date_format\":\"MM/DD/YYYY\"} \u2014 ascending by max_days, first fit wins\n- clone: {}\n- conditional: {\"rules\":[{\"conditions\":{\"type\":\"group\",\"match\":\"all\"|\"any\",\"children\":[{\"type\":\"condition\",\"field\":\"..\",\"operator\":\"..\",\"value\":\"..\"}]},\"output\":\"..\"}],\"fallback\":\"{{token}}\"}\n- script: {\"script\":\"...\"} \u2014 matched against a whitelist of supported transforms; anything unrecognised returns the original value with an explicit error in the trace"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "output_token",
    "transform_type"
  ]
}