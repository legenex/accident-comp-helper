{
  "name": "Theme",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "description": {
      "type": "string"
    },
    "config": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}